---
import { SITE_AUTHOR } from '../consts';
import { BEIAN_LINKS, TRAVELLINGS } from '../config/footer';
const today = new Date();
---

<footer>
	<div class="footer-content">
		<div class="colophon">
			<span class="mark" aria-hidden="true"></span>
			&copy; {today.getFullYear()} {SITE_AUTHOR} · All rights reserved.
		</div>
		<div class="social-links">
			<a href="https://github.com/SALTWOOD" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href={TRAVELLINGS.href} target="_blank" rel="noopener noreferrer">
				<img src={TRAVELLINGS.logo} alt={TRAVELLINGS.alt} height="24" width="91" loading="lazy" />
			</a>
		</div>
		<div class="beian">
			{
				BEIAN_LINKS.map((item) => (
					<a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>
				))
			}
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 2.5em 1em 6em 1em;
		color: rgb(var(--ink-soft));
		text-align: center;
		font-size: 0.92em;
		border-top: 1px solid var(--rule);
		background: linear-gradient(var(--gray-gradient)) no-repeat;
	}
	.footer-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
	}
	.colophon {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		letter-spacing: 0.01em;
	}
	.colophon .mark {
		width: 0.5em;
		height: 0.5em;
		background: var(--brass);
		transform: rotate(45deg);
	}
	.social-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.7em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--ink-soft));
		display: inline-flex;
		align-items: center;
		padding: 0.4em;
		border-radius: var(--r-sm);
		transition: color 0.15s ease, background 0.15s ease;
	}
	.social-links a svg {
		width: 24px;
		height: 24px;
	}
	.social-links a:hover {
		color: var(--sea);
		background: rgba(var(--sea-rgb), 0.1);
	}
	.social-links img {
		height: 24px;
		width: auto;
		display: block;
		border-radius: 0;
		opacity: 0.75;
		transition: opacity 0.15s ease;
	}
	.social-links a:hover img {
		opacity: 1;
	}
	.beian {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.78em;
	}
	.beian a {
		color: rgb(var(--ink-soft));
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.beian a:hover {
		color: var(--sea);
		text-decoration: underline;
	}
	[data-theme='dark'] .beian a:hover {
		color: var(--brass-soft);
	}
</style>
