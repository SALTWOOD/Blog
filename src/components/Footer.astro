---
import { SITE_AUTHOR } from '../config/site';
import { BEIAN_LINKS, TRAVELLINGS } from '../config/footer';
import Icon from './Icon.astro';
const today = new Date();
---

<footer>
	<div class="footer-content">
		<div class="colophon">
			<span class="mark" aria-hidden="true"></span>
			&copy; {today.getFullYear()} {SITE_AUTHOR} · All rights reserved.
		</div>
		<div class="social-links">
			<a href="https://github.com/SALTWOOD" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">GitHub</span>
				<Icon name="github" width={24} height={24} />
			</a>
			<a href={TRAVELLINGS.href} target="_blank" rel="noopener noreferrer">
				<img src={TRAVELLINGS.logo} alt={TRAVELLINGS.alt} height="24" width="91" loading="lazy" />
			</a>
		</div>
		<div class="beian">
			{
				BEIAN_LINKS.map((item) => (
					<a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>
				))
			}
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 2.5em 1em 6em 1em;
		color: rgb(var(--ink-soft));
		text-align: center;
		font-size: 0.92em;
		border-top: 1px solid var(--rule);
		background: linear-gradient(var(--gray-gradient)) no-repeat;
	}
	.footer-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
	}
	.colophon {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		letter-spacing: 0.01em;
	}
	.colophon .mark {
		width: 0.5em;
		height: 0.5em;
		background: var(--brass);
		transform: rotate(45deg);
	}
	.social-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.7em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--ink-soft));
		display: inline-flex;
		align-items: center;
		padding: 0.4em;
		border-radius: var(--r-sm);
		transition: color 0.15s ease, background 0.15s ease;
	}
	.social-links a :global(svg) {
		width: 24px;
		height: 24px;
	}
	.social-links a:hover {
		color: var(--sea);
		background: rgba(var(--sea-rgb), 0.1);
	}
	.social-links img {
		height: 24px;
		width: auto;
		display: block;
		border-radius: 0;
		opacity: 0.75;
		transition: opacity 0.15s ease;
	}
	.social-links a:hover img {
		opacity: 1;
	}
	.beian {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.78em;
	}
	.beian a {
		color: rgb(var(--ink-soft));
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.beian a:hover {
		color: var(--sea);
		text-decoration: underline;
	}
	[data-theme='dark'] .beian a:hover {
		color: var(--brass-soft);
	}
</style>
