---
import signature from '../assets/signature.png';

import { SITE_TITLE } from '../config/site';
import { isNavActive, labelFor, navFor } from '../config/nav';
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const headerLinks = navFor('header');
const mobileLinks = navFor('mobile');
const isActive = (href: string) => isNavActive(pathname, href);
---

<header>
	<nav>
		<h2>
			<a href="/" aria-label={SITE_TITLE}>
				<span class="brand__signature" style={`--signature:url("${signature.src}")`}></span>
			</a>
		</h2>
		<div class="internal-links">
			{headerLinks.map((link) => (
				<HeaderLink href={link.href}>{labelFor(link, 'header')}</HeaderLink>
			))}
		</div>
		<div class="social-links">
			<a href="/search" title="搜索">
				<span class="sr-only">搜索</span>
				<Icon name="search" width={24} height={24} />
			</a>
			<div class="toggle-slot" data-toggle-slot="desktop">
				<ThemeToggle />
			</div>
			<a href="https://github.com/SALTWOOD" target="_blank">
				<span class="sr-only">GitHub</span>
				<Icon name="github" width={32} height={32} />
			</a>
		</div>
		<button
			id="menu-toggle"
			class="menu-toggle"
			type="button"
			aria-label="菜单"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<Icon name="menu" width={24} height={24} />
		</button>
	</nav>
	<div id="mobile-menu" class="mobile-menu" hidden>
		{mobileLinks.map((link) => (
			<a href={link.href} class:list={['mobile-link', { active: isActive(link.href) }]}>
				{labelFor(link, 'mobile')}
			</a>
		))}
		<div class="mobile-actions">
			<div class="toggle-slot" data-toggle-slot="mobile"></div>
			<a href="https://github.com/SALTWOOD" target="_blank" class="mobile-github">
				<span class="sr-only">GitHub</span>
				<Icon name="github" width={32} height={32} />
			</a>
		</div>
	</div>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 40;
		margin: 0;
		padding: 0 1.5em;
		background: var(--bg-header);
		-webkit-backdrop-filter: blur(10px) saturate(1.2);
		backdrop-filter: blur(10px) saturate(1.2);
		border-top: 3px solid var(--brass);
		border-bottom: 1px solid var(--rule);
	}
	h2 {
		margin: 0;
		line-height: 1;
	}
	h2 a {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		color: rgb(var(--ink));
	}
	/* The signature PNG is transparent with black brushwork; use its alpha as
	   a mask over currentColor so it follows the ink colour in both themes. */
	.brand__signature {
		display: block;
		width: 8.75rem;
		height: 2.625rem;
		transform: translateY(3px);
		background-color: currentColor;
		-webkit-mask: var(--signature) center / contain no-repeat;
		mask: var(--signature) center / contain no-repeat;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1em;
		max-width: 64rem;
		margin: 0 auto;
	}
	nav > h2,
	.social-links {
		flex: 1 1 0;
	}
	nav > h2 {
		min-width: 0;
	}
	.internal-links {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		gap: 0.1em;
	}
	nav :global(.internal-links) a {
		padding: 1em 0.7em;
		color: rgb(var(--ink));
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.97rem;
		font-weight: 500;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	nav :global(.internal-links) a:hover {
		color: var(--sea);
	}
	nav :global(.internal-links) a.active {
		color: var(--sea-deep);
		border-bottom-color: var(--brass);
		font-weight: 600;
	}
	[data-theme='dark'] nav :global(.internal-links) a.active {
		color: var(--brass-soft);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links {
		gap: 0.35em;
		align-items: center;
		justify-content: flex-end;
	}
	.social-links a {
		color: rgb(var(--ink));
		padding: 0.5em;
		border-radius: var(--r-sm);
		transition: color 0.15s ease, background 0.15s ease;
	}
	.social-links a:hover {
		color: var(--sea);
		background: rgba(var(--sea-rgb), 0.1);
	}
	.social-links a :global(svg) {
		width: 20px;
		height: 20px;
	}
	/* The toggle slot wrapper dissolves so the ThemeToggle button stays a direct
	   flex child of .social-links on desktop (byte-identical layout). It also
	   serves as a stable anchor for reparenting the single toggle instance. */
	.toggle-slot {
		display: contents;
	}
	/* Hamburger button — hidden on desktop, shown on mobile. */
	.menu-toggle {
		display: none;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5em;
		color: rgb(var(--ink));
		align-items: center;
		justify-content: center;
		border-radius: var(--r-sm);
	}
	.menu-toggle:hover {
		color: var(--sea);
		background: rgba(var(--sea-rgb), 0.1);
	}
	.menu-toggle :global(svg) {
		display: block;
	}
	/* Dropdown panel — always hidden on desktop. */
	.mobile-menu {
		display: none;
	}
	@media (max-width: 720px) {
		.internal-links,
		.social-links {
			display: none;
		}
		.menu-toggle {
			display: flex;
		}
		.mobile-menu {
			position: absolute;
			top: calc(100% + 1px);
			right: 0.75em;
			left: 0.75em;
			z-index: 50;
			display: block;
			background: var(--paper-raised);
			border: 1px solid var(--rule);
			border-top: 2px solid var(--brass);
			box-shadow: var(--box-shadow);
			border-radius: var(--r-md);
			padding: 0.4em 0;
			overflow: hidden;
		}
		.mobile-menu[hidden] {
			display: none;
		}
		.mobile-menu .mobile-link {
			display: block;
			box-sizing: border-box;
			min-height: 44px;
			padding: 0.8em 1.1em;
			color: rgb(var(--ink));
			border-bottom: none;
			text-decoration: none;
			font-weight: 500;
		}
		.mobile-menu .mobile-link:hover {
			background: rgba(var(--sea-rgb), 0.08);
			color: var(--sea);
		}
		.mobile-menu .mobile-link.active {
			font-weight: 600;
			color: var(--sea-deep);
			border-left: 3px solid var(--brass);
			padding-left: calc(1.1em - 3px);
		}
		.mobile-actions {
			display: flex;
			align-items: center;
			gap: 0.5em;
			box-sizing: border-box;
			min-height: 44px;
			padding: 0.7em 1.1em;
			margin-top: 0.25em;
			border-top: 1px solid var(--rule);
		}
		.mobile-actions .mobile-github {
			display: flex;
			align-items: center;
		}
	}
</style>
<script is:inline>
	(function () {
		function closeMenu() {
			var panel = document.getElementById('mobile-menu');
			var btn = document.getElementById('menu-toggle');
			if (panel) panel.setAttribute('hidden', '');
			if (btn) btn.setAttribute('aria-expanded', 'false');
		}
		function openMenu() {
			var panel = document.getElementById('mobile-menu');
			var btn = document.getElementById('menu-toggle');
			if (panel) panel.removeAttribute('hidden');
			if (btn) btn.setAttribute('aria-expanded', 'true');
		}
		function relocateToggle() {
			var mobile = window.matchMedia('(max-width: 720px)').matches;
			var slot = document.querySelector(
				mobile ? '[data-toggle-slot="mobile"]' : '[data-toggle-slot="desktop"]'
			);
			if (!slot) return;
			// Move every slotted toggle (theme + background) into the active slot,
			// preserving document order so they stay grouped.
			document.querySelectorAll('[data-slot-toggle]').forEach(function (toggle) {
				if (toggle.parentNode !== slot) slot.appendChild(toggle);
			});
		}
		function init() {
			relocateToggle();
		}

		if (!window.__headerMenuInit) {
			window.__headerMenuInit = true;
			document.addEventListener('click', function (e) {
				var btn = e.target.closest('#menu-toggle');
				if (btn) {
					var panel = document.getElementById('mobile-menu');
					if (panel && panel.hasAttribute('hidden')) openMenu();
					else closeMenu();
					return;
				}
				var panel = document.getElementById('mobile-menu');
				if (!panel || panel.hasAttribute('hidden')) return;
				// Clicking a nav link inside closes the panel.
				if (e.target.closest('#mobile-menu .mobile-link')) {
					closeMenu();
					return;
				}
				// Clicking anywhere outside the panel closes it.
				if (!e.target.closest('#mobile-menu')) {
					closeMenu();
				}
			});
			document.addEventListener('keydown', function (e) {
				if (e.key !== 'Escape') return;
				var panel = document.getElementById('mobile-menu');
				if (panel && !panel.hasAttribute('hidden')) {
					closeMenu();
					var btn = document.getElementById('menu-toggle');
					if (btn) btn.focus();
				}
			});
			window
				.matchMedia('(max-width: 720px)')
				.addEventListener('change', function () {
					closeMenu();
					relocateToggle();
				});
			document.addEventListener('astro:after-swap', init);
		}

		init();
	})();
</script>
