---
const COMMENT_SCRIPT = 'https://comments-new.ski.ink/comment.js';
const COMMENT_SITE_ID = 'e9ae98c1-3aed-4144-9407-fd18aec0bfae';
---

<section class="comments" data-pagefind-ignore>
	<div id="comment-now-section"></div>
	<script is:inline defer src={COMMENT_SCRIPT} data-site-id={COMMENT_SITE_ID} data-astro-rerun></script>
	<script is:inline>
		if (!window.__commentThemeBridge) {
			window.__commentThemeBridge = true;

			function syncCommentTheme() {
				var host = document.querySelector('#comment-now-section [data-comment-now-interactive]');
				var root = host && host.shadowRoot;
				var base = root && root.querySelector('style:not([data-site-theme])');
				if (!base) return;

				var css = base.textContent || '';
				var light = /:host\s*\{([^}]*--cn-bg[^}]*)\}/.exec(css);
				var dark = /prefers-color-scheme:\s*dark[^{]*\{[^{]*:host\s*\{([^}]*)\}/.exec(css);
				if (!light || !dark) return;

				var site = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
				var os = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				var extra = site === os ? '' : ':host {' + (site === 'dark' ? dark[1] : light[1]) + '}';

				var style = root.querySelector('style[data-site-theme]');
				if (!style) {
					style = document.createElement('style');
					style.setAttribute('data-site-theme', '');
					root.appendChild(style);
				}
				if (style.textContent !== extra) style.textContent = extra;
			}

			// The widget mounts asynchronously (external script), so watch the
			// container instead of guessing a delay.
			function observeComments() {
				var box = document.getElementById('comment-now-section');
				if (!box || box.__cnThemeObserved) return;
				box.__cnThemeObserved = true;
				new MutationObserver(syncCommentTheme).observe(box, { childList: true, subtree: true });
				syncCommentTheme();
			}

			document.addEventListener('astro:page-load', observeComments);
			window.addEventListener('theme-change', syncCommentTheme);
			observeComments();
		}
	</script>
</section>

<style>
	.comments {
		margin-top: 3em;
		padding-top: 2em;
		border-top: 1px solid var(--rule);
	}
</style>
