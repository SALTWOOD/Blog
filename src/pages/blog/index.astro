---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { homeSidebar } from '../../config/sidebar';
import { ANALYTICS, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { readingStats } from '../../lib/reading';

const all = await getCollection('blog');
const pinned = all
	.filter((post) => (post.data.pinned ?? 0) > 0)
	.sort((a, b) => {
		const pa = a.data.pinned ?? 0;
		const pb = b.data.pinned ?? 0;
		if (pb !== pa) return pb - pa;
		return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
	});
const posts = all
	.filter((post) => !((post.data.pinned ?? 0) > 0))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const stats = new Map(all.map((post) => [post.id, readingStats(post.body ?? '')]));

const umamiSd = ANALYTICS.umami.statisticsDisplay;
const showPv = ANALYTICS.umami.enabled && !!ANALYTICS.umami.websiteId && !!umamiSd?.enabled && !!umamiSd?.token;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 1240px;
				max-width: calc(100% - 2em);
			}

			.page-intro {
				margin: 0 0 1.75rem;
				color: rgba(255, 255, 255, 0.88);
				text-shadow: var(--text-veil);
			}
			.page-intro h1 {
				margin: 0 0 0.4rem;
				color: #fff;
				text-shadow: var(--text-veil);
				font-size: clamp(1.9rem, 4vw, 2.5rem);
			}
			.page-intro p {
				margin: 0;
				max-width: 42rem;
				line-height: 1.7;
			}

			.home-layout {
				display: flex;
				gap: 2.25em;
				align-items: flex-start;
			}
			.home-content {
				flex: 1;
				min-width: 0;
			}

			.log-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				margin: 0 0 1.75rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--rule);
			}
			.log-head h2 {
				margin: 0;
				font-size: 1.3rem;
				font-weight: 600;
				color: #fff;
				text-shadow: var(--text-veil);
			}
			.log-head .count {
				font-family: var(--font-mono);
				font-size: 0.85rem;
				color: rgba(255, 255, 255, 0.7);
				text-shadow: var(--text-veil);
			}

			.featured {
				margin-bottom: 2.5rem;
			}
			.featured-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1em;
				margin: 0 0 1.5rem;
				padding-bottom: 0.6rem;
				border-bottom: 1px solid var(--brass);
			}
			.featured-head .eyebrow {
				font-family: var(--font-mono);
				font-size: 0.82rem;
				font-weight: 600;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				color: rgba(255, 255, 255, 0.82);
				text-shadow: var(--text-veil);
			}
			.featured-head .count {
				font-family: var(--font-mono);
				font-size: 0.82rem;
				color: rgba(255, 255, 255, 0.7);
				text-shadow: var(--text-veil);
			}
			ul.featured-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul.featured-grid li {
				min-width: 0;
			}
			.featured-card {
				position: relative;
				display: block;
				box-sizing: border-box;
				text-decoration: none;
				background: color-mix(in srgb, var(--paper-raised) 82%, transparent);
				border: 1px solid color-mix(in srgb, var(--rule) 92%, transparent);
				border-top: 3px solid var(--brass);
				border-radius: 14px;
				padding: 1.25rem 1.4rem;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
				height: 100%;
				backdrop-filter: blur(18px) saturate(1.3);
				-webkit-backdrop-filter: blur(18px) saturate(1.3);
			}
			.featured-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 12px 30px rgba(var(--brass-rgb), 0.18), 0 10px 34px rgba(var(--ink), 0.16);
			}
			.featured-card :global(img) {
				width: calc(100% + 2.8rem);
				height: auto;
				margin: 0 -1.4rem 1.1rem;
				display: block;
				border-radius: 0;
				border-bottom: 1px solid var(--rule);
			}
			.featured-card .pin-badge {
				position: absolute;
				top: 0.7rem;
				right: 0.8rem;
				z-index: 2;
				display: inline-flex;
				align-items: center;
				gap: 0.3em;
				padding: 0.18rem 0.6rem 0.18rem 0.5rem;
				border-radius: var(--r-pill);
				background: rgba(var(--brass-rgb), 0.95);
				color: #fff7e8;
				font-family: var(--font-mono);
				font-size: 0.66rem;
				font-weight: 600;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
			}
			.featured-card .pin-badge svg {
				width: 0.82em;
				height: 0.82em;
			}
			.featured-card .title {
				font-size: 1.55rem;
			}

			ul.entries {
				column-count: 2;
				column-gap: 1.75rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul.entries li {
				break-inside: avoid;
				page-break-inside: avoid;
				margin-bottom: 1.75rem;
			}
			.entry {
				display: block;
				box-sizing: border-box;
				text-decoration: none;
				background: color-mix(in srgb, var(--paper-raised) 82%, transparent);
				border: 1px solid color-mix(in srgb, var(--rule) 92%, transparent);
				border-left: 3px solid transparent;
				border-radius: 14px;
				padding: 1.1rem 1.25rem;
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
				height: 100%;
				backdrop-filter: blur(18px) saturate(1.3);
				-webkit-backdrop-filter: blur(18px) saturate(1.3);
			}
			.entry:hover {
				transform: translateY(-3px);
				box-shadow: 0 10px 30px rgba(var(--ink), 0.18);
				border-left-color: var(--brass);
			}
			.entry :global(img) {
				width: calc(100% + 2.5rem);
				height: auto;
				margin: -1.1rem -1.25rem 1rem;
				display: block;
				border-radius: 14px 14px 0 0;
				border-bottom: 1px solid var(--rule);
			}
			.entry-meta {
				display: flex;
				align-items: center;
				gap: 0.5em;
				font-family: var(--font-mono);
				font-size: 0.76rem;
				letter-spacing: 0.02em;
				color: rgb(var(--ink-soft));
				margin-bottom: 0.4rem;
				text-transform: uppercase;
			}
			.entry-meta .cat {
				color: var(--sea);
			}
			.entry-meta .dot {
				color: var(--rule);
			}
			.entry-meta .pv {
				display: inline-flex;
				align-items: center;
				gap: 0.3em;
				color: rgb(var(--ink-soft));
			}
			.entry-meta .pv svg {
				width: 1em;
				height: 1em;
			}
			.title {
				margin: 0;
				color: rgb(var(--ink));
				line-height: 1.3;
				font-size: 1.35rem;
				font-family: var(--font-body);
				font-weight: 600;
				transition: color 0.15s ease;
			}
			.desc {
				margin: 0.55rem 0 0;
				color: rgb(var(--ink-soft));
				font-size: 0.92rem;
				line-height: 1.6;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.entry-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35em;
				margin-top: 0.75rem;
			}
			.entry-tags .tag-chip {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				letter-spacing: 0.02em;
				padding: 0.12em 0.5em;
				border-radius: var(--r-sm);
				background: var(--paper-chip);
				border: 1px solid var(--rule);
				color: rgb(var(--ink-soft));
			}
			.entry:hover .title {
				color: var(--sea);
			}
			[data-theme='dark'] .entry:hover .title {
				color: var(--brass-soft);
			}
			@media (max-width: 720px) {
				ul.entries {
					column-count: 1;
					column-gap: 0;
				}
				ul.featured-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="content-root">
			<div class="page-intro">
				<h1>航行日志</h1>
				<p>{all.length} 篇记录 · 记录游戏、运维、安全与逆向工程的实践与思考</p>
			</div>
			<div class="home-layout">
				<Sidebar blocks={homeSidebar} />
				<section class="home-content">
					{pinned.length > 0 && (
						<section class="featured">
							<div class="featured-head">
								<span class="eyebrow">Pinned · 置顶</span>
								<span class="count">{pinned.length} 篇记录</span>
							</div>
							<ul class="featured-grid">
								{
									pinned.map((post) => (
										<li>
											<a class="featured-card" href={`/blog/${post.id}/`}>
												<span class="pin-badge">
													<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
														<line x1="12" y1="17" x2="12" y2="22" />
														<path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z" />
													</svg>
													置顶
												</span>
												{post.data.heroImage && (
													<Image width={720} height={360} src={post.data.heroImage} alt={post.data.title} transition:name={`hero-${post.id}`} />
												)}
												<div class="entry-meta">
													<time><FormattedDate date={post.data.pubDate} /></time>
													{post.data.category && (
														<>
															<span class="dot">/</span>
															<span class="cat">{post.data.category}</span>
														</>
													)}
													<span class="dot">/</span>
													<span>{stats.get(post.id)?.minutes ?? 1} 分钟</span>
													<span class="dot">/</span>
													<span>{stats.get(post.id)?.wordCount ?? 0} 字</span>{showPv && (<> <span class="dot">/</span><span class="pv" title="浏览量"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg><span data-umami-pv={`/blog/${post.id}/`}>…</span></span> </>)}
												</div>
												<h2 class="title">{post.data.encrypted ? `🔒 ${post.data.title}` : post.data.title}</h2>
												{post.data.description && <p class="desc">{post.data.description}</p>}
												{post.data.tags.length > 0 && (
													<div class="entry-tags">
														{post.data.tags.slice(0, 3).map((tag) => <span class="tag-chip">#{tag}</span>)}
													</div>
												)}
											</a>
										</li>
									))
								}
							</ul>
						</section>
					)}
					<div class="log-head">
						<h2>全部记录</h2>
						<span class="count">{posts.length} 篇记录</span>
					</div>
					<ul class="entries">
						{
							posts.map((post) => (
								<li>
									<a class="entry" href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<Image width={720} height={360} src={post.data.heroImage} alt={post.data.title} transition:name={`hero-${post.id}`} />
										)}
										<div class="entry-meta">
											<time><FormattedDate date={post.data.pubDate} /></time>
											{post.data.category && (
												<>
													<span class="dot">/</span>
													<span class="cat">{post.data.category}</span>
												</>
											)}
											<span class="dot">/</span>
											<span>{stats.get(post.id)?.minutes ?? 1} 分钟</span>
											<span class="dot">/</span>
											<span>{stats.get(post.id)?.wordCount ?? 0} 字</span>{showPv && (<> <span class="dot">/</span><span class="pv" title="浏览量"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" /></svg><span data-umami-pv={`/blog/${post.id}/`}>…</span></span> </>)}
										</div>
										<h2 class="title">{post.data.encrypted ? `🔒 ${post.data.title}` : post.data.title}</h2>
										{post.data.description && <p class="desc">{post.data.description}</p>}
										{post.data.tags.length > 0 && (
											<div class="entry-tags">
												{post.data.tags.slice(0, 3).map((tag) => <span class="tag-chip">#{tag}</span>)}
											</div>
										)}
									</a>
								</li>
							))
						}
					</ul>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
