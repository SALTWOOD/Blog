---
import { getCollection } from 'astro:content';
import {
	siBun,
	siCplusplus,
	siDocker,
	siDotnet,
	siFsharp,
	siGo,
	siHtml5,
	siJavascript,
	siMariadb,
	siMysql,
	siNodedotjs,
	siOpenjdk,
	siPhp,
	siPostgresql,
	siPython,
	siRedis,
	siRust,
	siTypescript,
	siVuedotjs,
	siVuetify,
} from 'simple-icons';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { ICON_BODIES } from '../components/ui/icons';
import { TRAVELLINGS } from '../config/footer';
import { SITE_ALTERNATE_NAME, SITE_DESCRIPTION, SITE_KICKER, SITE_TITLE } from '../consts';
import { authorPerson } from '../lib/schema';
import '../styles/glass.css';
import '../styles/glitch.css';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	alternateName: SITE_ALTERNATE_NAME,
	url: new URL('/', Astro.site).href,
	description: SITE_DESCRIPTION,
	inLanguage: 'zh-CN',
	publisher: authorPerson(Astro.site),
};

const contacts = [
	{ label: '邮箱', href: 'mailto:admin@ski.ink', icon: 'mail', external: false },
	{ label: '博客', href: '/blog', icon: 'book-open', external: false },
	{ label: 'GitHub', href: 'https://github.com/SALTWOOD', icon: 'github', external: true },
	{ label: 'RSS', href: '/rss.xml', icon: 'rss', external: false },
	{
		label: '请给我钱',
		href: 'monero:47AUhaafGKJKEiycvvSWtL4uYR3MKcWDbV9nWX6QzuXhMRvdjayxD4ELGwArcZYdPuJe6KgFc7tzsZYWbtTmcUChJagiWcZ',
		icon: 'coins',
		external: false,
	},
];

const sites = [
	{ label: '博客', href: '/blog', icon: 'book-open' },
	{ label: '工具', href: '/tools', icon: 'wrench' },
	{ label: '友链', href: '/friends', icon: 'users' },
	{ label: '服务状态', href: 'https://saltwood.top:3001/status/all', icon: 'activity' },
	{ label: '开往', href: TRAVELLINGS.href, icon: 'train-front' },
];

const techs = [
	{ label: 'TypeScript', icon: siTypescript },
	{ label: '.NET', icon: siDotnet },
	{ label: 'F#', icon: siFsharp },
	{ label: 'Python', icon: siPython },
	{ label: 'PHP', icon: siPhp },
	{ label: 'JavaScript', icon: siJavascript },
	{ label: 'Java', icon: siOpenjdk },
	{ label: 'Vue.js', icon: siVuedotjs },
	{ label: 'Node.js', icon: siNodedotjs },
	{ label: 'HTML5', icon: siHtml5 },
	{ label: 'Bun', icon: siBun },
	{ label: 'Go', icon: siGo },
	{ label: 'Rust', icon: siRust },
	{ label: 'Vuetify', icon: siVuetify },
	{ label: 'Docker', icon: siDocker },
	{ label: 'C++', icon: siCplusplus },
	{ label: 'PostgreSQL', icon: siPostgresql },
	{ label: 'MySQL', icon: siMysql },
	{ label: 'MariaDB', icon: siMariadb },
	{ label: 'Redis', icon: siRedis },
];

function brandColor(hex: string) {
	const r = parseInt(hex.slice(0, 2), 16);
	const g = parseInt(hex.slice(2, 4), 16);
	const b = parseInt(hex.slice(4, 6), 16);
	return r * 0.299 + g * 0.587 + b * 0.114 < 60 ? 'rgb(var(--ink))' : `#${hex}`;
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
		<style>
			main.home {
				width: 1080px;
				max-width: calc(100% - 2em);
				padding: 0;
			}

			.hero {
				position: relative;
				box-sizing: border-box;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				min-height: calc(100svh - 4.5rem);
				padding: 3rem 1.25rem 6rem;
			}

			.hero h1 {
				position: relative;
				margin: 0 0 1rem;
				color: #fff;
				text-shadow: var(--text-veil);
				font-size: clamp(2.6rem, 7vw, 4.2rem);
				line-height: 1.12;
				letter-spacing: -0.01em;
			}

			.hero .kicker {
				display: block;
				margin-bottom: 0.7rem;
				font-family: var(--font-accent);
				font-style: italic;
				font-weight: 400;
				font-size: clamp(1rem, 2vw, 1.25rem);
				letter-spacing: 0;
				color: rgba(255, 255, 255, 0.82);
				text-shadow: var(--text-veil);
			}

			.hero .lede {
				position: relative;
				margin: 0 0 0.5rem;
				max-width: 40rem;
				font-size: 1.1rem;
				line-height: 1.7;
				color: rgba(255, 255, 255, 0.86);
				text-shadow: var(--text-veil);
			}

			.hero .sub {
				position: relative;
				margin: 0 0 2rem;
				max-width: 38rem;
				font-family: var(--font-body);
				font-size: 0.92rem;
				line-height: 1.7;
				color: rgba(255, 255, 255, 0.7);
				text-shadow: var(--text-veil);
			}

			.hero-cta {
				position: relative;
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.75rem;
			}

			.scroll-cue {
				position: absolute;
				bottom: 1.5rem;
				left: 50%;
				transform: translateX(-50%);
				display: inline-flex;
				padding: 0.35rem;
				border-radius: 50%;
				color: rgba(255, 255, 255, 0.72);
				text-shadow: var(--text-veil);
				animation: cue-bounce 2s ease-in-out infinite;
			}

			.scroll-cue svg {
				width: 1.35rem;
				height: 1.35rem;
			}

			@keyframes cue-bounce {
				0%,
				100% {
					transform: translate(-50%, 0);
				}
				50% {
					transform: translate(-50%, 8px);
				}
			}

			.cards {
				display: flex;
				flex-direction: column;
				gap: 1.2rem;
				box-sizing: border-box;
				padding: 0 1rem 4.5rem;
				scroll-margin-top: 4.5rem;
			}

			#about {
				scroll-margin-top: 4.5rem;
			}

			.person {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 1.1rem;
			}

			.person .avatar {
				width: 72px;
				height: 72px;
				flex-shrink: 0;
				border-radius: 50%;
				object-fit: cover;
				border: 2px solid color-mix(in srgb, var(--brass) 45%, transparent);
			}

			.person-name {
				font-family: var(--font-body);
				font-size: 1.3rem;
				font-weight: 600;
				color: rgb(var(--ink));
			}

			.person-desc {
				margin: 0.15rem 0 0;
				font-size: 0.9rem;
				line-height: 1.5;
				color: rgb(var(--ink-soft));
			}

			.contacts {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6rem;
				margin-top: 1.2rem;
			}

			.contacts .glass-btn {
				min-height: 2.5rem;
				padding: 0.45rem 0.9rem;
				font-size: 0.9rem;
			}

			.posts {
				display: flex;
				flex-direction: column;
			}

			.post-row {
				display: flex;
				align-items: baseline;
				gap: 0.85rem;
				padding: 0.6rem 0.35rem;
				border-radius: 8px;
				border-bottom: 1px dashed color-mix(in srgb, var(--rule) 80%, transparent);
				color: rgb(var(--ink));
				text-decoration: none;
				transition: background 0.15s ease;
			}

			.post-row:last-child {
				border-bottom: none;
			}

			.post-row:hover {
				background: rgba(var(--ink), 0.05);
				color: rgb(var(--ink));
				text-decoration: none;
			}

			.post-date {
				flex-shrink: 0;
				font-family: var(--font-mono);
				font-size: 0.76rem;
				letter-spacing: 0.02em;
				color: rgb(var(--ink-soft));
			}

			.post-title {
				font-weight: 500;
				line-height: 1.45;
			}

			.post-cat {
				margin-left: auto;
				flex-shrink: 0;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--sea);
			}

			.tech-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				list-style: none;
				margin: 1rem 0 0;
				padding: 0;
			}

			.tech-chip {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.28rem 0.6rem;
				border: 1px solid color-mix(in srgb, var(--rule) 90%, transparent);
				border-radius: var(--r-pill);
				background: color-mix(in srgb, var(--paper-raised) 55%, transparent);
				color: rgb(var(--ink-soft));
				font-size: 0.8rem;
				line-height: 1.4;
			}

			.tech-chip svg {
				width: 0.95rem;
				height: 0.95rem;
				flex-shrink: 0;
				color: var(--brand, currentColor);
			}

			.more-link {
				display: inline-flex;
				align-items: center;
				gap: 0.3em;
				margin-top: 1rem;
				font-family: var(--font-mono);
				font-size: 0.82rem;
				color: var(--sea);
				text-decoration: none;
			}

			.more-link:hover {
				text-decoration: underline;
			}

			.more-link svg {
				width: 0.95rem;
				height: 0.95rem;
			}

			@media (max-width: 720px) {
				.hero {
					min-height: calc(100svh - 4rem);
					padding: 2rem 1rem 5rem;
				}

				.cards {
					padding: 0 0 3.5rem;
					gap: 0.9rem;
				}

				.person {
					gap: 0.8rem;
				}

				.post-row {
					flex-wrap: wrap;
					gap: 0.2rem 0.7rem;
				}

				.post-cat {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<h1>
					<span class="kicker">{SITE_KICKER}</span>
					<span class="glitch-wrap" aria-hidden="true">
						<span class="glitch" data-text={SITE_TITLE}>{SITE_TITLE}</span>
					</span>
					<span class="sr-only">{SITE_TITLE}</span>
				</h1>
				<p class="lede">欢迎光临，这里是盐木的小破窝~</p>
				<p class="sub">{SITE_DESCRIPTION}</p>
				<div class="hero-cta">
					<a class="glass-btn solid" href="/blog">
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON_BODIES['book-open']} />
						浏览文章
					</a>
					<a class="glass-btn" href="#about">
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON_BODIES.info} />
						关于我
					</a>
				</div>
				<a class="scroll-cue" href="#content" aria-label="向下浏览">
					<svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON_BODIES['chevron-down']} />
				</a>
			</section>

			<div class="cards" id="content">
				<section class="glass-card" id="about">
					<div class="glass-head">
						<h2>关于</h2>
						<span class="meta">About</span>
					</div>
					<div class="person">
						<img class="avatar" src="/avatar.webp" alt="SALTWOOD" width="72" height="72" />
						<div>
							<span class="person-name">SALTWOOD</span>
							<p class="person-desc">一个废物高中生</p>
							<p class="person-desc">爱折腾编程，喜欢聊天，啥都想干却啥都干不好</p>
						</div>
					</div>
					<div class="glass-body">
						<p>
							一位学生，网名 <strong>SaltWood_233</strong>，大家可以叫我<strong>盐木</strong>！<br />
							喜欢写写代码、玩玩游戏，和听歌~ 爱玩碧蓝航线之类的二游、部分音游、战舰世界和 Minecraft！
						</p>
						<p>
							<a href="https://github.com/PCL-Community" target="_blank" rel="noopener">@PCL-Community</a> 成员，PCL2 的社区维护者之一，主要参与
							<a href="https://github.com/PCL-Community/PCL-CE" target="_blank" rel="noopener"> PCL-CE</a> 的 C# 化重构。
						</p>
					</div>
					<div class="contacts">
						{
							contacts.map((item) => (
								<a class="glass-btn" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>
									<svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON_BODIES[item.icon]} />
									{item.label}
								</a>
							))
						}
					</div>
				</section>

				<section class="glass-card">
					<div class="glass-head">
						<h2>去逛逛</h2>
						<span class="meta">Sites</span>
					</div>
					<div class="glass-grid">
						{
							sites.map((site) => (
								<a class="glass-btn" href={site.href} target={site.href.startsWith('http') ? '_blank' : undefined} rel={site.href.startsWith('http') ? 'noopener' : undefined}>
									<svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON_BODIES[site.icon]} />
									{site.label}
								</a>
							))
						}
					</div>
				</section>

				<section class="glass-card">
					<div class="glass-head">
						<h2>最近更新</h2>
						<span class="meta">Log</span>
					</div>
					<div class="posts">
						{
							posts.map((post) => (
								<a class="post-row" href={`/blog/${post.id}/`}>
									<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
									<span class="post-title">{post.data.encrypted ? `🔒 ${post.data.title}` : post.data.title}</span>
									{post.data.category && <span class="post-cat">{post.data.category}</span>}
								</a>
							))
						}
					</div>
					<a class="more-link" href="/blog">
						全部文章
						<svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON_BODIES['arrow-right']} />
					</a>
				</section>

				<section class="glass-card">
					<div class="glass-head">
						<h2>技术栈</h2>
						<span class="meta">Stacks</span>
					</div>
					<div class="glass-body">
						<p>比较擅长 <strong>C#</strong>、<strong>Python</strong> 与 <strong>TypeScript</strong>，也会一点别的（小声）。</p>
					</div>
					<ul class="tech-list">
						{
							techs.map((tech) => (
								<li class="tech-chip" style={`--brand:${brandColor(tech.icon.hex)}`}>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d={tech.icon.path} fill="currentColor" />
									</svg>
									<span>{tech.label}</span>
								</li>
							))
						}
					</ul>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
