---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import { ARTWORKS } from '../../config/artworks';
import { SITE_TITLE } from '../../config/site';
import '../../styles/glass.css';

const first = ARTWORKS[0];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`作品 - ${SITE_TITLE}`} description="盐木的作品" />
		<meta name="robots" content="noindex, nofollow" />
		<style>
			main {
				width: 1080px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em 4.5em;
			}
			.art-layout {
				display: grid;
				grid-template-columns: 280px minmax(0, 1fr);
				gap: 1.25rem;
				align-items: start;
			}
			.art-index {
				display: flex;
				flex-direction: column;
				gap: 0.9rem;
			}
			.art-index-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
			}
			.art-count {
				font-family: var(--font-mono);
				font-size: 0.76rem;
				letter-spacing: 0.08em;
				color: rgb(var(--ink-soft));
			}
			.random-btn {
				padding: 0.4rem 0.75rem;
				border: 1px solid var(--rule);
				border-radius: var(--r-pill);
				background: var(--paper-raised);
				color: var(--sea);
				font-family: var(--font-mono);
				font-size: 0.72rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				cursor: pointer;
				transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
			}
			.random-btn:hover:not(:disabled) {
				background: var(--sea);
				border-color: var(--sea);
				color: #fff;
			}
			.random-btn:disabled {
				opacity: 0.4;
				cursor: default;
			}
			.art-thumbs {
				list-style: none;
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0.6rem;
				margin: 0;
				padding: 0.25rem;
				max-height: 34rem;
				overflow-y: auto;
				scrollbar-width: thin;
			}
			.art-thumb {
				display: block;
				width: 100%;
				aspect-ratio: 1;
				padding: 0;
				overflow: hidden;
				border: 1px solid var(--rule);
				border-radius: 10px;
				background: var(--paper-chip);
				cursor: pointer;
				transition: border-color 0.15s ease, box-shadow 0.15s ease;
			}
			.art-thumb img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.25s ease;
			}
			.art-thumb:hover img {
				transform: scale(1.04);
			}
			.art-thumb.active {
				border-color: var(--brass);
				box-shadow: 0 0 0 2px rgba(var(--brass-rgb), 0.28);
			}
			.art-empty {
				margin: 0;
				padding: 1.5rem 1rem;
				border: 1px dashed rgba(var(--brass-rgb), 0.35);
				border-radius: 10px;
				text-align: center;
				color: rgb(var(--ink-soft));
				font-size: 0.88rem;
				line-height: 1.6;
			}
			.art-viewer {
				display: flex;
				flex-direction: column;
				padding: 0;
				overflow: hidden;
			}
			.viewer-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.75rem 1rem;
				border-bottom: 1px solid var(--rule);
				background: color-mix(in srgb, var(--paper-raised) 70%, transparent);
				font-family: var(--font-mono);
				font-size: 0.78rem;
				letter-spacing: 0.06em;
			}
			.viewer-title {
				color: rgb(var(--ink));
			}
			.viewer-index {
				color: var(--brass);
				white-space: nowrap;
			}
			.viewer-body {
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 30rem;
				background: color-mix(in srgb, var(--paper-chip) 60%, transparent);
			}
			.viewer-body img {
				display: block;
				width: auto;
				height: auto;
				max-width: 100%;
				max-height: 34rem;
				object-fit: contain;
			}
			.viewer-empty {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.6rem;
				padding: 4rem 1.5rem;
				text-align: center;
				color: rgb(var(--ink-soft));
				font-size: 0.92rem;
			}
			.viewer-empty :global(svg) {
				width: 2rem;
				height: 2rem;
				color: var(--brass);
				opacity: 0.6;
			}
			.viewer-empty p {
				margin: 0;
			}
			.viewer-caption {
				min-height: 3.2em;
				margin: 0;
				padding: 0.8rem 1rem;
				border-top: 1px solid var(--rule);
				color: rgb(var(--ink-soft));
				font-size: 0.9rem;
				line-height: 1.6;
			}
			.viewer-caption:empty {
				display: none;
			}
			@media (max-width: 860px) {
				.art-layout {
					grid-template-columns: 1fr;
				}
				.art-thumbs {
					grid-template-columns: repeat(4, 1fr);
					max-height: none;
				}
			}
			@media (max-width: 640px) {
				main {
					padding: 2em 0.75em 3.5em;
				}
				.art-thumbs {
					grid-template-columns: repeat(3, 1fr);
				}
				.viewer-body {
					min-height: 20rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<span class="eyebrow">Artworks</span>
				<h1>美术作品</h1>
				<p class="lede">盐木的原创角色设定</p>
			</header>

			<div class="art-layout" data-art-gallery>
				<section class="art-index" aria-label="作品列表">
					<div class="art-index-head">
						<span class="art-count">{ARTWORKS.length} 张作品</span>
						<button type="button" id="art-random" class="random-btn" disabled={ARTWORKS.length < 2}>
							随机
						</button>
					</div>

					{
						ARTWORKS.length > 0 ? (
							<ul class="art-thumbs">
								{ARTWORKS.map((piece, index) => (
									<li>
										<button
											type="button"
											class:list={['art-thumb', { active: index === 0 }]}
											data-art
											data-src={piece.src}
											data-alt={piece.alt}
											data-title={piece.title ?? ''}
											data-caption={piece.caption ?? ''}
											aria-label={piece.alt}
										>
											<img src={piece.src} alt="" loading="lazy" />
										</button>
									</li>
								))}
							</ul>
						) : (
							<p class="art-empty">作品整理中，咕咕咕……</p>
						)
					}
				</section>

				<section class="glass-card art-viewer" aria-live="polite">
					<div class="viewer-head">
						<span class="viewer-title" id="art-title">{first?.title ?? '暂无作品'}</span>
						<span class="viewer-index" id="art-index">
							{ARTWORKS.length > 0 ? `1 / ${ARTWORKS.length}` : '0 / 0'}
						</span>
					</div>
					<div class="viewer-body">
						{
							first ? (
								<img id="art-main" src={first.src} alt={first.alt} />
							) : (
								<div class="viewer-empty">
									<Icon name="image" />
									<p>作品整理中，咕咕咕……</p>
								</div>
							)
						}
					</div>
					<p class="viewer-caption" id="art-caption">{first?.caption ?? ''}</p>
				</section>
			</div>
		</main>
		<Footer />
		<script is:inline data-astro-rerun>
			(function () {
				var root = document.querySelector('[data-art-gallery]');
				if (!root) return;

				var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-art]'));
				var main = root.querySelector('#art-main');
				var title = root.querySelector('#art-title');
				var index = root.querySelector('#art-index');
				var caption = root.querySelector('#art-caption');

				function select(i) {
					var thumb = thumbs[i];
					if (!thumb || !main) return;
					main.src = thumb.getAttribute('data-src') || '';
					main.alt = thumb.getAttribute('data-alt') || '';
					if (title) title.textContent = thumb.getAttribute('data-title') || '';
					if (index) index.textContent = i + 1 + ' / ' + thumbs.length;
					if (caption) caption.textContent = thumb.getAttribute('data-caption') || '';
					thumbs.forEach(function (item, j) {
						item.classList.toggle('active', j === i);
					});
				}

				thumbs.forEach(function (thumb, i) {
					thumb.addEventListener('click', function () {
						select(i);
					});
				});

				var randomBtn = root.querySelector('#art-random');
				if (randomBtn) {
					randomBtn.addEventListener('click', function () {
						if (thumbs.length < 2) return;
						select(Math.floor(Math.random() * thumbs.length));
					});
				}
			})();
		</script>
	</body>
</html>
